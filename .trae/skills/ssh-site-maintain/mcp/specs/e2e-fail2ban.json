    { "name": "f2b_jail_status", "arguments": { "jail": "sshd" } },
    { "name": "f2b_unban", "arguments": { "ip": "192.0.2.123", "jail": "sshd" } },
    { "name": "f2b_jail_status", "arguments": { "jail": "sshd" } },
    { "name": "f2b_log_tail", "arguments": { "lines": 10, "grep": "192.0.2.123" } }
  ]
