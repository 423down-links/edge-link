    { "name": "list-servers", "arguments": {} },
    { "name": "set-active-ssh-connection", "arguments": { "connectionName": "default" } },
    { "name": "execute-command", "arguments": { "cmdString": "echo active-default-ok" } },
    { "name": "diagnose-ssh-connection", "arguments": { "connectionName": "test-dup" } },
    { "name": "save-ssh-connection", "arguments": { "connectionName": "test-dup", "configFilePath": "/tmp/mcp-save-test.json", "includeSensitive": false } }
