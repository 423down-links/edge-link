{
  "server": "node",
  "args": ["node_modules/@lhtdeg/ssh-mcp-server/build/index.js", "--host", "127.0.0.1", "--port", "22022", "--username", "root", "--privateKey", "/root/.ssh/id_ed25519", "--pty", "false", "--allowed-local-paths", "/tmp", "--allowed-remote-paths", "/tmp"],
  "expectTools": ["diagnose-ssh-connection", "list-servers", "add-ssh-connection", "set-active-ssh-connection", "save-ssh-connection"],
